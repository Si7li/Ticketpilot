# ---- Models ----
# Anthropic API key. Required only when the real backend is constructed (agent runs, evals).
ANTHROPIC_API_KEY=
# Agent model: classification, extraction, tools, drafting, validation
AGENT_MODEL=claude-haiku-5-5
# Judge model: evaluation only. Deliberately different from the agent model.
JUDGE_MODEL=claude-sonnet-5-5
# Output token cap per call (thinking is on by default on current models)
LLM_MAX_TOKENS=8000
# SDK retries on 429/5xx/connection errors
LLM_MAX_RETRIES=4
LLM_TIMEOUT_S=120
# json_schema (native structured outputs) | function_calling
LLM_STRUCTURED_METHOD=json_schema

# ---- Thresholds ----
# Refunds at or below this amount (USD) auto-approve; above require human approval
AUTO_APPROVE_REFUND_LIMIT=100
# Minimum classifier confidence for auto-send
CONFIDENCE_THRESHOLD=0.80
# Maximum tool calls in the act loop
MAX_TOOL_STEPS=4
# Number of KB chunks retrieved per ticket
RETRIEVAL_TOP_K=5
# Reciprocal-rank-fusion constant
RRF_K=60
# bm25 | vector | hybrid
RETRIEVAL_MODE=hybrid
# false only for ablations
VALIDATION_ENABLED=true
# Comma-separated categories that are always escalated
SENSITIVE_CATEGORIES=other_sensitive

# ---- Policy windows (days) ----
DOMESTIC_RETURN_DAYS=30
INTERNATIONAL_RETURN_DAYS=14
PEAK_RETURN_DAYS=60
DAMAGED_REPORT_DAYS=14
WRONG_ITEM_REPORT_DAYS=14
# Country treated as "domestic"
HOME_COUNTRY=US

# ---- Data ----
BUSINESS_DB_PATH=data/ticketpilot.db
CHECKPOINT_DB_PATH=data/checkpoints.db
# Fixed "today" so date-window logic is reproducible
REFERENCE_DATE=2026-10-01
KB_DIR=data/kb

# ---- Vector store ----
# Empty → in-memory Qdrant. In Docker: http://qdrant:6333
QDRANT_URL=
QDRANT_COLLECTION=kestrel_kb
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed caches the model (empty = library default). Docker sets /opt/fastembed.
FASTEMBED_CACHE_DIR=

# ---- Observability (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Pricing (optional, USD per million tokens). Leave empty to report tokens only. ----
# Anthropic list prices as of 2026-10 (verify at https://claude.com/pricing before relying on them):
#   claude-haiku-5-5: input 0.10, output 0.50   claude-sonnet-5-5: input 2.00, output 10.00
AGENT_PRICE_INPUT_PER_MTOK=
AGENT_PRICE_OUTPUT_PER_MTOK=
JUDGE_PRICE_INPUT_PER_MTOK=
JUDGE_PRICE_OUTPUT_PER_MTOK=

# ---- Eval harness ----
EVAL_CONCURRENCY=4

# ---- Review UI ----
API_URL=http://localhost:8000
